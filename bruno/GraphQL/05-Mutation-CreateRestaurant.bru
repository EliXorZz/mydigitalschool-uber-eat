meta {
  name: Mutation - Create Restaurant
  type: http
  seq: 5
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:graphql {
  mutation {
    createRestaurant(
      name: "Le Nouveau Restaurant"
      description: "Un excellent restaurant"
      city: "Paris"
      score: 4.5
      price_score: 2
      type_id: 1
      owner_id: 2
    ) {
      id
      name
      city
      score
    }
  }
}
