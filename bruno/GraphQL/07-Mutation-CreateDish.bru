meta {
  name: Mutation - Create Dish
  type: graphql
  seq: 7
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:graphql {
  mutation {
    createDish(
      restaurant_id: 1
      name: "Pizza Margherita"
      description: "Sauce tomate, mozzarella, basilic"
      price: 12.50
    ) {
      id
      name
      price
      restaurant {
        id
        name
      }
    }
  }
}
