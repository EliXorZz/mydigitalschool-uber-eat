meta {
  name: Query - Get Dish
  type: graphql
  seq: 4
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query {
    dish(id: 1) {
      id
      name
      description
      price
      image
      restaurant {
        id
        name
        city
      }
    }
  }
}
